# Copy this file to .env and fill in real values. .env is git-ignored.

# SQLAlchemy connection string for the MySQL database (required).
# Format: mysql+mysqlconnector://<user>:<password>@<host>/<database>
# URL-encode special characters in the password (for example @ becomes %40).
DATABASE_URL=mysql+mysqlconnector://your_user:your_password@localhost/mechanic_shop_api_db

# Key used to sign and verify JWTs (required outside DevelopmentConfig).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
